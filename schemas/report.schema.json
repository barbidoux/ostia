{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/barbidoux/ostia/schemas/report/v1/report.schema.json",
  "title": "Ostia scan report",
  "description": "Written by `ostia scan --report` (docs/contracts/cli.md). Field semantics: docs/contracts/report.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "session",
    "timing",
    "medium",
    "refusal",
    "policy",
    "engines",
    "objects",
    "medium_verdict"
  ],
  "properties": {
    "report_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "compliant"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["compliant", "selective", "scan-only"]},
        "compliant": {"type": "boolean"}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started", "ended", "max_scan_time_seconds", "on_expiry", "expired", "aborted"],
      "properties": {
        "started": {"$ref": "#/$defs/timestamp"},
        "ended": {"$ref": "#/$defs/timestamp"},
        "max_scan_time_seconds": {"type": "integer", "minimum": 1},
        "on_expiry": {"enum": ["block", "abort"]},
        "expired": {"type": "boolean"},
        "aborted": {"type": "boolean"}
      }
    },
    "medium": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "size", "file_system"],
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 0},
        "file_system": {
          "enum": ["fat12", "fat16", "fat32", "exfat", "ntfs", "ext2", "ext3", "ext4", null]
        }
      }
    },
    "refusal": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "unsupported_file_system",
                "policy_signature_invalid",
                "policy_invalid"
              ]
            },
            "message": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"type": ["string", "null"]},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "engines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "content_version"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "content_version": {"type": "string", "minLength": 1}
        }
      }
    },
    "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
    "medium_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "blocked", "blocking_objects", "findings"],
      "properties": {
        "verdict": {"$ref": "#/$defs/verdict"},
        "blocked": {"type": "boolean"},
        "blocking_objects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule", "title"],
            "properties": {
              "rule": {"enum": ["D1", "D2"]},
              "title": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "verdict": {"enum": ["CLEAN", "SUSPICIOUS", "MALICIOUS", "UNSCANNABLE"]},
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent_id",
        "origin",
        "depth",
        "path",
        "stream",
        "size",
        "sha256",
        "sha1",
        "modified",
        "attributes",
        "detected_type",
        "extension_mismatch",
        "double_extension",
        "verdict",
        "rule",
        "limit",
        "score",
        "contributing_engines",
        "explanation",
        "engine_results",
        "transferable"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "parent_id": {"type": ["string", "null"], "minLength": 1},
        "origin": {"enum": ["FILE", "EXTRACTED", "ALT_STREAM", "XATTR"]},
        "depth": {"type": "integer", "minimum": 0},
        "path": {"type": "string", "minLength": 1},
        "stream": {"type": ["string", "null"], "minLength": 1},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "sha1": {"oneOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]},
        "modified": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "attributes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["hidden", "system", "read_only", "archive"]}
        },
        "detected_type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "extension_mismatch": {"type": "boolean"},
        "double_extension": {"type": "boolean"},
        "verdict": {"$ref": "#/$defs/verdict"},
        "rule": {"enum": ["R1", "R2", "R3", "R4", "R5", "R6", "R7"]},
        "limit": {
          "enum": ["depth", "ratio", "total_size", "entry_count", "path_length", "scan_time", null]
        },
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "contributing_engines": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "explanation": {"type": "string", "minLength": 1},
        "engine_results": {"type": "array", "items": {"$ref": "#/$defs/engine_result"}},
        "transferable": {"type": "boolean"}
      }
    },
    "engine_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_id",
        "engine_version",
        "content_version",
        "status",
        "hint",
        "score",
        "findings",
        "duration_ms"
      ],
      "properties": {
        "engine_id": {"type": "string", "minLength": 1},
        "engine_version": {"type": "string", "minLength": 1},
        "content_version": {"type": "string", "minLength": 1},
        "status": {"enum": ["OK", "ERROR", "TIMEOUT", "UNSUPPORTED"]},
        "hint": {"enum": ["HINT_UNSPECIFIED", "NONE", "CLEAN", "SUSPICIOUS", "MALICIOUS"]},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "severity", "evidence", "attack_ids"],
            "properties": {
              "id": {"type": "string"},
              "title": {"type": "string"},
              "severity": {"type": "integer", "minimum": 0, "maximum": 4},
              "evidence": {"type": "string"},
              "attack_ids": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "duration_ms": {"type": "integer", "minimum": 0}
      }
    }
  }
}
